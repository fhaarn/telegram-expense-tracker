# Copy to .env and fill in local values. Never commit .env.
PORT=8080
DATABASE_URL=postgres://expense:expense@localhost:5432/expense_tracker?sslmode=disable
# Use a real development bot token to send onboarding replies.
TELEGRAM_BOT_TOKEN=replace-with-development-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-random-secret
TZ=Asia/Jakarta
DEFAULT_CURRENCY=IDR
# Hosted DATABASE_URL must use sslmode=verify-full.

# Optional until comparison invites are used (without @).
TELEGRAM_BOT_USERNAME=

# Optional: enables admin routes when set. Separate from Telegram secrets.
ADMIN_API_KEY=
